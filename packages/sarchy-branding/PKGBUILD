pkgname=sarchy-branding
pkgver=1.0.0
pkgrel=1
pkgdesc="Branding assets for Sarchy (Artix/Arch-based OS) — wallpaper, Plymouth, GRUB, SDDM and icons"
url="https://github.com/gt-ayush/Sarchy-iso"
arch=('any')
license=('GPL3')
depends=()
optdepends=('plymouth: boot splash theme'
            'grub: bootloader theme'
            'sddm: display manager theme')
install=sarchy-branding.install
# All source files live in this repo (usr/share/...), so no remote sources.
source=()
sha256sums=()
# Do not strip or compress branding assets.
options=(!strip !emptydirs !debug)

package() {
    # Install everything under usr/share directly into the package root.
    # Source files live in the repo root (startdir), not in srcdir/src.
    cp -a "${startdir}/usr" "${pkgdir}/usr"

    # Fix permissions: directories 755, files 644.
    find "${pkgdir}" -type d -exec chmod 755 {} +
    find "${pkgdir}" -type f -exec chmod 644 {} +
}
